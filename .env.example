# Clé API TCG (référentiel) — compte gratuit sur https://apitcg.com/register,
# clé récupérable sur https://apitcg.com/platform/api-key
APITCG_API_KEY=

# Clé JustTCG (prix) — compte gratuit sur https://justtcg.com/auth/signup
# Header attendu : x-api-key: tcg_xxxxxxxx (coller juste la clé, avec le préfixe tcg_)
JUSTTCG_API_KEY=

# Supabase — Project Settings > Database > Connection string (URI)
DATABASE_URL=

# Optionnel, seulement si on utilise un jour le client Supabase (REST/SDK)
# au lieu d'une connexion Postgres directe. Project Settings > API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=