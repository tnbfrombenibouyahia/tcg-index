# Clé API TCG (référentiel) — compte gratuit sur https://apitcg.com/register,
# clé récupérable sur https://apitcg.com/platform/api-key
APITCG_API_KEY=

# Clé JustTCG (prix) — compte gratuit sur https://justtcg.com/auth/signup
# Header attendu : x-api-key: tcg_xxxxxxxx (coller juste la clé, avec le préfixe tcg_)
JUSTTCG_API_KEY=

# Cloud SQL (Postgres) — connexion directe. sslmode=require suffit (pas de
# sslrootcert : le certificat Cloud SQL n'est pas dans un magasin de CA
# public, cf. shared/db.py) :
# postgresql://<user>:<password>@<ip>:5432/<db>?sslmode=require
DATABASE_URL=

# eBay Browse API (listings actifs) — developer.ebay.com, ton app.
EBAY_APP_ID=
EBAY_CERT_ID=

# --- Micro-service de verdict (pricing_api/, appelé par l'extension navigateur) ---

# Durée de vie du cache de prix (table `prices`) avant de rappeler la source
# et de mettre à jour la ligne, en heures. Défaut 12 si absent.
PRICE_CACHE_TTL_HOURS=12

# Seuils de verdict, en ratio (prix affiché / prix de référence médian) :
# sous GREEN_MAX -> vert, entre GREEN_MAX et YELLOW_MAX -> jaune, au-dessus -> rouge.
VERDICT_GREEN_MAX_RATIO=0.85
VERDICT_YELLOW_MAX_RATIO=1.15

# Origines CORS autorisées pour l'extension (séparées par des virgules,
# ex. chrome-extension://<id>). Vide = CORS désactivé (utile en local).
PRICING_API_CORS_ORIGINS=

# OCR (passage 1 de la cascade image, cf. pricing/ocr.py) -- clé API Cloud
# Vision restreinte à Vision API, cardquant-tcg > APIs & Services >
# Identifiants. Vide = OCR désactivé, identify_card(image_url=...) répond
# directement not_found sans appeler Cloud Vision.
GOOGLE_CLOUD_VISION_API_KEY=

# Vérification des sessions extension côté serveur (pricing/auth.py,
# "compte requis", §01/§09) -- apiKey PUBLIC de l'app Firebase Web
# "CardQuant Extension" (Firebase Console > Paramètres du projet >
# Général, ou `firebase apps:sdkconfig WEB <appId>`). Vide = /verdict
# refuse toute requête (401), aucun jeton ne peut être vérifié.
FIREBASE_WEB_API_KEY=