# Supabase — même connection pooler (Supavisor) que côté ingestion Python,
# pas la connexion directe (IPv6-only). Project Settings > Database > Connection string (URI).
DATABASE_URL=

# Firebase Authentication (Google Sign-In, cf. components/auth/AuthModal.tsx)
# -- config PUBLIQUE du projet cardquant-tcg, pas des secrets (destinées à
# être embarquées côté client, doc Firebase "Understand Firebase API keys").
# `firebase apps:sdkconfig WEB <appId>` ou Firebase Console > Paramètres du
# projet > Général.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# pricing_api (cf. extension/lib/config.js -- même service, même URL) --
# appelé directement depuis le navigateur pour le portefeuille personnel
# (écran PnL CardQuant, /portfolio) : web/ n'a que du SELECT sur Postgres
# (cf. lib/db.ts), les écritures passent par ce service. Nécessite que
# l'origine de web/ soit listée dans PRICING_API_CORS_ORIGINS côté service
# (cf. pricing_api/main.py), sinon le préflight CORS échoue silencieusement.
NEXT_PUBLIC_PRICING_API_URL=https://pricing-api-606137510344.europe-west3.run.app
