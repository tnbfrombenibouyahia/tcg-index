# Supabase — même connection pooler (Supavisor) que côté ingestion Python,
# pas la connexion directe (IPv6-only). Project Settings > Database > Connection string (URI).
DATABASE_URL=

# Firebase Authentication (Google Sign-In, cf. components/auth/AuthModal.tsx)
# -- config PUBLIQUE du projet cardquant-tcg, pas des secrets (destinées à
# être embarquées côté client, doc Firebase "Understand Firebase API keys").
# `firebase apps:sdkconfig WEB <appId>` ou Firebase Console > Paramètres du
# projet > Général.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
